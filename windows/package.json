{
  "name": "laylat-al-mafia-desktop",
  "version": "1.1.0",
  "private": true,
  "main": "main.js",
  "description": "ليلة المافيا — Mafia Online (Windows)",
  "scripts": {
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.haydergaming.mafia",
    "productName": "ليلة المافيا",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "artifactName": "Mafia-Online-Windows-${version}.${ext}"
  }
}
